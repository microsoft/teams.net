<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Internal parsing and generated serializers use the experimental Plan models. -->
		<NoWarn>$(NoWarn);ExperimentalTeamsPlan</NoWarn>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>Microsoft.Teams.Apps</PackageId>
		<PackageDescription>Create Microsoft Teams Bot Applications with ease.</PackageDescription>
		<PackageTags>microsoft;teams;msteams;copilot;apps;bots</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Microsoft.Teams.Core\Microsoft.Teams.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="OpenTelemetry.Api" Version="1.15.3" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.32" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Microsoft.Teams.Apps.UnitTests" />
		<InternalsVisibleTo Include="Microsoft.Teams.M365Extensions" />
		<InternalsVisibleTo Include="Microsoft.Teams.M365Extensions.UnitTests" />
	</ItemGroup>
</Project>
