{
  "TokenValidation": {
    "Enabled": true,
    "Audiences": [
      "{{ClientId}}"
    ],
    "TenantId": "{{TenantId}}"
  },
  "AgentApplication": {
    "StartTypingTimer": false,
    "RemoveRecipientMention": false,
    "NormalizeMentions": false,
    "UserAuthorization": {
      "AutoSignin": false,
      "Handlers": {
        "graphuser": {
          "Settings": {
            "AzureBotOAuthConnectionName": "graphuser"
          }
        },
        "graphmail": {
          "Settings": {
            "AzureBotOAuthConnectionName": "graphmail"
          }
        }
      }
    }
  },
  "Connections": {
    "ServiceConnection": {
      "Settings": {
        "AuthType": "ClientSecret",
        "AuthorityEndpoint": "https://login.microsoftonline.com/{{TenantId}}",
        "ClientId": "{{ClientId}}",
        "ClientSecret": "{{ClientSecret}}",
        "Scopes": [
          "https://api.botframework.com/.default"
        ]
      }
    }
  },
  "ConnectionsMap": [
    {
      "ServiceUrl": "*",
      "Connection": "ServiceConnection"
    }
  ],
  "Logging": {
    "Debug": {
      "IncludeScopes": true
    },
    "Console": {
      "IncludeScopes": true
    },
    "LogLevel": {
      "Microsoft.Agents": "Debug",
      "Microsoft.Agents.Authentication.Msal.MsalAuth": "Warning",
      "System.Net.Http.HttpClient.MSALClientFactory": "Warning",
      "System.Net.Http.HttpClient.Microsoft.Agents.Builder.RestChannelServiceClientFactory": "Warning",
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Identity": "Warning"
    }
  }
}
