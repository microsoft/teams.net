<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- The sample exercises the experimental targeted-message API. -->
		<NoWarn>$(NoWarn);ExperimentalTeamsTargeted</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="wwwroot\**" />
		<Content Remove="wwwroot\**" />
		<EmbeddedResource Remove="wwwroot\**" />
		<None Remove="wwwroot\**" />
	</ItemGroup>

	<!-- The reusable Teams SDK + Agents SDK bridge, plus the Teams SDK app model it builds on. -->
	<ItemGroup>
		<ProjectReference Include="..\..\src\Microsoft.Teams.M365Extensions\Microsoft.Teams.M365Extensions.csproj" />
		<ProjectReference Include="..\..\src\Microsoft.Teams.Apps\Microsoft.Teams.Apps.csproj" />
		<ProjectReference Include="..\..\src\Microsoft.Teams.Cards\Microsoft.Teams.Cards.csproj" />
	</ItemGroup>

	<!-- The sample uses Agents SDK MSAL auth directly, in addition to what flows transitively from the bridge. -->
	<ItemGroup>
		<PackageReference Include="Microsoft.Agents.Authentication.Msal" Version="1.8.44-beta" />
		<PackageReference Include="Microsoft.Agents.Hosting.AspNetCore" Version="1.8.44-beta" />
	</ItemGroup>

</Project>
